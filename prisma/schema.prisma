// Prisma schema - generated based on project ERD
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Genre {
  id   Int    @id @default(autoincrement()) @db.UnsignedInt
  name String @unique @db.VarChar(50)

  films Film[]

  @@map("genres")
}

model Film {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  genre_id     Int    @db.UnsignedInt
  title        String @db.VarChar(150)
  description  String @db.Text
  poster       String @db.VarChar(255)
  release_year Int    @db.UnsignedSmallInt
  access_type  Int    @db.UnsignedTinyInt
  content_type Int    @db.UnsignedTinyInt

  genre    Genre     @relation(fields: [genre_id], references: [id])
  episodes Episode[]
  my_lists MyList[]

  @@index([genre_id])
  @@index([title])
  @@index([access_type])
  @@map("films")
}

model Episode {
  id             BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  film_id        BigInt @db.UnsignedBigInt
  title          String @db.VarChar(150)
  duration       Int    @db.UnsignedSmallInt
  url_video      String @db.VarChar(255)
  episode_number Int    @db.UnsignedInt

  film Film @relation(fields: [film_id], references: [id])

  @@index([film_id])
  @@index([film_id, episode_number])
  @@map("episodes")
}

model User {
  id       BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  name     String @db.VarChar(100)
  email    String @unique @db.VarChar(150)
  password String @db.VarChar(255)

  orders   Order[]
  my_lists MyList[]

  @@map("users")
}

model Package {
  id       Int     @id @default(autoincrement()) @db.UnsignedInt
  name     String  @db.VarChar(50)
  price    Decimal @db.Decimal(10, 2)
  duration Int     @db.UnsignedSmallInt

  orders Order[]

  @@map("packages")
}

model Order {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  package_id Int      @db.UnsignedInt
  order_date DateTime @db.DateTime
  status     String   @db.VarChar(50)

  user    User     @relation(fields: [user_id], references: [id])
  package Package  @relation(fields: [package_id], references: [id])
  payment Payment?

  @@index([user_id])
  @@index([package_id])
  @@index([user_id, status])
  @@map("orders")
}

model MyList {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt   @db.UnsignedBigInt
  film_id    BigInt   @db.UnsignedBigInt
  date_added DateTime @db.DateTime

  user User @relation(fields: [user_id], references: [id])
  film Film @relation(fields: [film_id], references: [id])

  @@unique([user_id, film_id])
  @@map("my_lists")
}

model Payment {
  id       BigInt  @id @default(autoincrement()) @db.UnsignedBigInt
  order_id BigInt  @unique @db.UnsignedBigInt
  method   String  @db.VarChar(50)
  amount   Decimal @db.Decimal(12, 2)
  status   String  @db.VarChar(50)

  order Order @relation(fields: [order_id], references: [id])

  @@index([status])
  @@map("payments")
}
